{
  "name": "@dsh-fly/dsh-plugin-fly-skins",
  "version": "0.2.4",
  "description": "DSH Fly skins: the four Fly palettes (solid / glass / volume / neon) as a standalone DSH bundle + client plugin — token layer, MiSans Latin chrome, dark-half neon scanline, Settings row",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSES"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "skin",
    "palette"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanchen669/dsh-plugin-fly-skins.git"
  },
  "homepage": "https://github.com/ethanchen669/dsh-plugin-fly-skins#readme",
  "bugs": {
    "url": "https://github.com/ethanchen669/dsh-plugin-fly-skins/issues"
  },
  "meta": {
    "title": "FLY Skins",
    "description": "四套配色（实心 / 玻璃 / 玻璃2 / 霓虹）× 明暗，重画官方 UI 的 chrome；霓虹深色带单向扫描线，拉丁字形用内置 MiSans Latin；在「设置 → 通用」里选。"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs .",
    "test": "node --test tests/*.spec.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run typecheck && node scripts/check-design-tokens.mjs && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
